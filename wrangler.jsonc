{
  // Toura (fost TourApp) pe Cloudflare Workers via OpenNext (blueprint §2.1)
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tourapp",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },
  // Expeditorul emailurilor (Resend) — domeniul toura.pro verificat în
  // contul soldoutmedia (2026-08-09). Secretele rămân în `wrangler secret`.
  "vars": { "EMAIL_FROM": "Toura <no-reply@toura.pro>" },
  // Domeniul custom: toura.pro + www (zona trebuie să fie ACTIVĂ înainte de
  // deploy — atașarea pe zonă pending a produs 1042 pe tot workerul, 2026-08-09).
  "routes": [
    { "pattern": "toura.pro", "custom_domain": true },
    { "pattern": "www.toura.pro", "custom_domain": true }
  ]
  // Secretele (SUPABASE_SERVICE_ROLE_KEY, GOOGLE_MAPS_API_KEY, RESEND_API_KEY)
  // se setează cu `wrangler secret put`, NU aici. Publicele merg în [vars]
  // sau în dashboard. Vezi docs/DEPLOY.md.
}
